diff --git a/lib/validate-ast.js b/lib/validate-ast.js
new file mode 100644
index 0000000000000000000000000000000000000000..cb645f5388293a59cbe5285b2c8737fba79563c9
--- /dev/null
+++ b/lib/validate-ast.js
@@ -0,0 +1,21 @@
+'use strict';
+
+// Bound every public AST walker, including caller-supplied ASTs. Parent/prev
+// links are intentionally cyclic in normal parsed ASTs; only visit child nodes.
+module.exports = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  const seen = new Set();
+  let count = 0;
+  while (pending.length) {
+    const { node, depth } = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth > 128 || seen.has(node) || ++count > 65536) {
+      throw new SyntaxError('Brace AST exceeds safe nesting or node limit');
+    }
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      if (node.nodes.length > 65536) throw new SyntaxError('Brace AST exceeds safe node limit');
+      for (const child of node.nodes) pending.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
